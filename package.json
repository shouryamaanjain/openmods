{
  "name": "openmods-registry",
  "private": true,
  "type": "module",
  "workspaces": [
    "cli"
  ],
  "scripts": {
    "openmods": "bun cli/src/index.ts",
    "typecheck": "bunx tsc --noEmit && bun run --cwd cli typecheck",
    "validate": "bun script/validate.ts",
    "site": "bun script/site.ts --out site",
    "test": "bun test cli/test"
  },
  "devDependencies": {
    "@types/bun": "1.3.13",
    "marked": "16",
    "typescript": "5.9.3"
  }
}
