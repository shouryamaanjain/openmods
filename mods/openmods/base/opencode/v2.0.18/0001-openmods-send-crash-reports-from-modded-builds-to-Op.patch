From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: OpenMods <openmods@localhost>
Date: Sun, 27 Sep 2026 05:35:46 +0530
Subject: [PATCH] openmods: send crash reports from modded builds to OpenMods

A modded build still looks like OpenCode, so its crash screen would send
people to the OpenCode project, which did not ship the mods. It now tells
them to check with `openmods off` and, if stock OpenCode does not crash,
copies a report, with the version, which names the mods, for them to read
and paste into an OpenMods issue.

diff --git a/packages/tui/src/component/error-component.tsx b/packages/tui/src/component/error-component.tsx
index 48ad4b107d755a296266c89ceb7479b6bd771b18..4c109db8248520247f0a41d0a72cf8f440b8e83f 100644
--- a/packages/tui/src/component/error-component.tsx
+++ b/packages/tui/src/component/error-component.tsx
@@ -43,11 +43,11 @@ export function ErrorComponent(props: { error: Error; reset: () => void; mode?:
 
   const message = props.error.message || "An unknown error occurred."
   const stack = props.error.stack || "No stack trace available."
-  const issueURL = buildIssueURL(message, stack, app.version)
+  const report = buildReport(message, stack, app.version)
 
   const copyReport = () => {
     void clipboard
-      .write(issueURL.toString())
+      .write(report)
       .then(() => setCopyState("copied"))
       .catch(() => setCopyState("failed"))
   }
@@ -205,10 +205,10 @@ export function ErrorComponent(props: { error: Error; reset: () => void; mode?:
           <box flexDirection="column" alignItems="center" flexShrink={0}>
             <text fg={colors.muted}>
               {copyState() === "copied"
-                ? "Report copied — paste it into a new GitHub issue."
+                ? "Report copied — read it, then paste it into a new issue at github.com/shouryamaanjain/openmods/issues/new"
                 : copyState() === "failed"
                   ? "Clipboard write failed. Try again or report the crash manually."
-                  : "Copy the report and open a GitHub issue to help us fix this."}
+                  : "A modded OpenCode: if stock OpenCode (`openmods off`) crashes too, report it to OpenCode; if not, copy the report for OpenMods."}
             </text>
             <text fg={colors.muted}>OpenCode {app.version}</text>
           </box>
@@ -218,41 +218,16 @@ export function ErrorComponent(props: { error: Error; reset: () => void; mode?:
   )
 }
 
-function buildIssueURL(message: string, stack: string, version: string) {
-  // Field keys match the ids in .github/ISSUE_TEMPLATE/bug-report.yml so the issue
-  // form opens pre-filled. Populating os/terminal/reproduce keeps the report past
-  // the contributing-guidelines compliance check, which pushes for system info.
-  const url = new URL("https://github.com/anomalyco/opencode/issues/new?template=bug-report.yml")
-  url.searchParams.set("title", `TUI crash: ${message}`)
-  url.searchParams.set("opencode-version", version)
-  url.searchParams.set("os", describeOS())
-  url.searchParams.set("terminal", describeTerminal())
-  url.searchParams.set(
-    "reproduce",
-    "Reported automatically from the OpenCode crash screen. If you can, describe what you were doing when it crashed.",
+function buildReport(message: string, stack: string, version: string) {
+  // A modded build, made with OpenMods: crashes are reported to OpenMods, not
+  // to the OpenCode project, which did not ship the mods. The version names
+  // the mods built in. The report is copied as text, for the person to read
+  // before pasting it into an issue; nothing is put in a link.
+  return (
+    `Crash in modded OpenCode: ${message}\n\n` +
+    `**Version:** ${version}\n**OS:** ${describeOS()}\n**Terminal:** ${describeTerminal()}\n\n` +
+    `Does it also crash in stock OpenCode (\`openmods off\`)? If so, report it to OpenCode instead.\n\n` +
+    `**Error:** ${message}\n\n**Stack trace:**\n` +
+    "```\n" + stack + "\n```"
   )
-
-  // Budget the stack against the fully URL-encoded length (not the raw length) so
-  // the final link stays under GitHub's practical limit; flag truncation so a
-  // clipped trace is obvious. searchParams.set handles encoding without throwing,
-  // so measuring url.toString() is both correct and safe on any input.
-  const MAX_URL_LENGTH = 6000
-  const marker = "\n… (truncated)"
-  const head = `The OpenCode TUI crashed with an unexpected error.\n\n**Error:** ${message}\n\n**Stack trace:**\n`
-  const setBody = (body: string) => url.searchParams.set("description", head + "```\n" + body + "\n```")
-
-  setBody(stack)
-  if (url.toString().length <= MAX_URL_LENGTH) return url
-
-  // Largest raw stack prefix whose encoded URL (with the marker) still fits.
-  let lo = 0
-  let hi = stack.length
-  while (lo < hi) {
-    const mid = Math.ceil((lo + hi) / 2)
-    setBody(stack.slice(0, mid) + marker)
-    if (url.toString().length <= MAX_URL_LENGTH) lo = mid
-    else hi = mid - 1
-  }
-  setBody(stack.slice(0, lo) + marker)
-  return url
 }
