+fn extract_turns(items: &[RolloutItem]) -> Vec<HistoryTurn> {
+    let mut extractor = TurnExtractor::new(Retain::All);
+    for item in items {
+        extractor.push(item);
+    }
+    extractor.finish()
+}
+
+fn turn(user: &str, assistant: Option<&str>) -> HistoryTurn {
+    HistoryTurn {
+        kind: TurnKind::Assistant,
+        user: user.to_string(),
+        assistant: assistant.map(str::to_string),
+        execution: TurnExecution::default(),
+    }
+}
+
+#[test]
+fn extracts_turns_with_final_answer_and_execution_evidence() {
+    let patch = "*** Begin Patch\n*** Update File: src/deploy.rs\n*** Move to: src/release.rs\n@@\n-a\n+b\n*** Add File: notes.md\n+hi\n*** End Patch\n";
+    let items = parse(&[
+        user("<environment_context>\n  <cwd>/repo</cwd>\n</environment_context>"),
+        user("Switch the deploy to cobalt"),
+        assistant("Looking at the deploy script.", "commentary"),
+        function_call("exec_command", r#"{"cmd":"rg cobalt"}"#, "call-1"),
+        function_output("call-1", "deploy.sh:3: color=blue"),
+        custom_call("apply_patch", patch, "call-2"),
+        custom_output("call-2", "Success"),
+        assistant("Cobalt is selected.", "final_answer"),
+        user("Thanks"),
+    ]);
+
+    let turns = extract_turns(&items);
+
+    assert_eq!(
+        turns,
+        vec![
+            HistoryTurn {
+                kind: TurnKind::Assistant,
+                user: "Switch the deploy to cobalt".to_string(),
+                assistant: Some("Cobalt is selected.".to_string()),
+                execution: TurnExecution {
+                    commentary: vec!["Looking at the deploy script.".to_string()],
+                    tool_calls: vec![
+                        ToolCallEvidence {
+                            name: "exec_command".to_string(),
+                            namespace: None,
+                            arguments: r#"{"cmd":"rg cobalt"}"#.to_string(),
+                        },
+                        ToolCallEvidence {
+                            name: "apply_patch".to_string(),
+                            namespace: None,
+                            arguments: patch.to_string(),
+                        },
+                    ],
+                    tool_results: vec![
+                        ToolResultEvidence {
+                            name: "exec_command".to_string(),
+                            preview: "deploy.sh:3: color=blue".to_string(),
+                        },
+                        ToolResultEvidence {
+                            name: "apply_patch".to_string(),
+                            preview: "Success".to_string(),
+                        },
+                    ],
+                    files: vec![
+                        FileEvidence {
+                            path: "src/deploy.rs".to_string(),
+                            change: FileChangeKind::Update,
+                            new_path: Some("src/release.rs".to_string()),
+                        },
+                        FileEvidence {
+                            path: "notes.md".to_string(),
+                            change: FileChangeKind::Add,
+                            new_path: None,
+                        },
+                    ],
+                },
+            },
+            turn("Thanks", /*assistant*/ None),
+        ]
+    );
+}
+
+#[test]
+fn compacted_items_and_summaries_are_not_turns() {
+    let summary = format!("{}\nWe chose cobalt.", crate::compact::SUMMARY_PREFIX);
+    let items = parse(&[
+        user("first question"),
+        assistant("first answer", "final_answer"),
+        compacted("We chose cobalt."),
+        user(&summary),
+        user("second question"),
+        assistant("second answer", "final_answer"),
+    ]);
+
+    assert_eq!(
+        extract_turns(&items),
+        vec![
+            turn("first question", Some("first answer")),
+            turn("second question", Some("second answer")),
+        ]
+    );
+}
+
+#[test]
+fn rolled_back_turns_are_dropped_and_aborted_turns_are_interrupted() {
+    let items = parse(&[
+        user("kept"),
+        assistant("kept answer", "final_answer"),
+        user("undone"),
+        assistant("undone answer", "final_answer"),
+        event(json!({ "type": "thread_rolled_back", "num_turns": 1 })),
+        user("stopped"),
+        event(json!({ "type": "turn_aborted", "reason": "interrupted" })),
+    ]);
+
+    let mut stopped = turn("stopped", /*assistant*/ None);
+    stopped.kind = TurnKind::Interrupted;
+    assert_eq!(
+        extract_turns(&items),
+        vec![turn("kept", Some("kept answer")), stopped]
+    );
+}
+
+#[test]
+fn long_tool_output_previews_are_bounded() {
+    let output = "é".repeat(400);
+    let items = parse(&[
+        user("run it"),
+        function_call("exec_command", "{}", "call-1"),
+        function_output("call-1", &output),
+    ]);
+
+    let preview = &extract_turns(&items)[0].execution.tool_results[0].preview;
+
+    assert!(preview.ends_with("..."));
+    assert!(preview.len() <= MAX_RESULT_PREVIEW_BYTES + 3);
+}
