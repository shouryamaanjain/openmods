+//! Lexical relevance of saved turns: whole-word matches in user and assistant text count
+//! strongly, substring matches in execution evidence count weakly.
+
+use super::turns::HistoryTurn;
+
+const ELLIPSIS: &str = "...";
+
+/// Distinct query terms (runs of Unicode letters and digits), lowercased.
+pub(super) struct PreparedQuery {
+    raw: String,
+    tokens: Vec<String>,
+}
+
+impl PreparedQuery {
+    pub(super) fn new(raw: &str) -> Self {
+        let mut tokens: Vec<String> = Vec::new();
+        for token in raw
+            .split(|ch: char| !ch.is_alphanumeric())
+            .filter(|token| !token.is_empty())
+        {
+            let token = token.to_lowercase();
+            if !tokens.contains(&token) {
+                tokens.push(token);
+            }
+        }
+        Self {
+            raw: raw.to_string(),
+            tokens,
+        }
+    }
+}
+
+/// Ordering: an exact session-id mention first, then more matched terms, then more terms
+/// matched in user or assistant text.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, PartialOrd, Ord)]
+pub(super) struct Score {
+    exact_identity: bool,
+    total_hits: usize,
+    strong_hits: usize,
+}
+
+pub(super) struct ScoredTurn<'a> {
+    pub(super) score: Score,
+    pub(super) excerpt_source: &'a str,
+}
+
+struct ScoreAccumulator<'q> {
+    query: &'q PreparedQuery,
+    exact_identity: bool,
+    strong: Vec<bool>,
+    weak: Vec<bool>,
+}
+
+impl<'q> ScoreAccumulator<'q> {
+    fn new(query: &'q PreparedQuery, session_id: &str) -> Self {
+        Self {
+            query,
+            exact_identity: contains_complete_identity(&query.raw, session_id),
+            strong: vec![false; query.tokens.len()],
+            weak: vec![false; query.tokens.len()],
+        }
+    }
+
+    /// User and assistant text: a term counts when it appears as a whole word.
+    fn add_strong(&mut self, field: &str) -> bool {
+        let field = field.to_lowercase();
+        let mut matched = false;
+        for (index, token) in self.query.tokens.iter().enumerate() {
+            if contains_complete_token(&field, token) {
+                matched = true;
+                self.strong[index] = true;
+                self.weak[index] = false;
+            }
+        }
+        matched
+    }
+
+    /// Tool names, arguments, result previews and file paths: any substring counts.
+    fn add_weak(&mut self, field: &str) -> bool {
+        let field = field.to_lowercase();
+        let mut matched = false;
+        for (index, token) in self.query.tokens.iter().enumerate() {
+            if field.contains(token.as_str()) {
+                matched = true;
+                if !self.strong[index] {
+                    self.weak[index] = true;
+                }
+            }
+        }
+        matched
+    }
+
+    fn finish(self) -> Option<Score> {
+        let strong_hits = self.strong.iter().filter(|hit| **hit).count();
+        let weak_hits = self.weak.iter().filter(|hit| **hit).count();
+        if !self.exact_identity && strong_hits == 0 && weak_hits == 0 {
+            return None;
+        }
+        Some(Score {
+            exact_identity: self.exact_identity,
+            total_hits: strong_hits + weak_hits,
+            strong_hits,
+        })
+    }
+}
+
+/// Scores a turn, returning `None` when nothing matched. The excerpt comes from the first
+/// of the user message and final assistant reply that matched, else the user message.
+/// Execution evidence counts toward the score but is only shown by `session_history_read`.
+pub(super) fn score_turn<'a>(
+    query: &PreparedQuery,
+    session_id: &str,
+    turn: &'a HistoryTurn,
+) -> Option<ScoredTurn<'a>> {
+    let mut accumulator = ScoreAccumulator::new(query, session_id);
+    let mut excerpt_source: Option<&'a str> = None;
+    let execution = &turn.execution;
+    let conversation = std::iter::once(turn.user.as_str()).chain(turn.assistant.as_deref());
+    for field in conversation {
+        if accumulator.add_strong(field) && excerpt_source.is_none() {
+            excerpt_source = Some(field);
+        }
+    }
+    // Assistant progress messages are assistant text, but read shows them as execution.
+    for field in &execution.commentary {
+        accumulator.add_strong(field);
+    }
+    let weak_fields =
+        execution
+            .tool_calls
+            .iter()
+            .flat_map(|call| [call.name.as_str(), call.arguments.as_str()])
+            .chain(
+                execution
+                    .tool_results
+                    .iter()
+                    .flat_map(|result| [result.name.as_str(), result.preview.as_str()]),
+            )
+            .chain(execution.files.iter().flat_map(|file| {
+                std::iter::once(file.path.as_str()).chain(file.new_path.as_deref())
+            }));
+    for field in weak_fields {
+        accumulator.add_weak(field);
+    }
+    let score = accumulator.finish()?;
+    Some(ScoredTurn {
+        score,
+        excerpt_source: excerpt_source.unwrap_or(turn.user.as_str()),
+    })
+}
+
+fn contains_complete_token(field: &str, token: &str) -> bool {
+    field.match_indices(token).any(|(start, matched)| {
+        let before = field[..start].chars().next_back();
+        let after = field[start + matched.len()..].chars().next();
+        !before.is_some_and(char::is_alphanumeric) && !after.is_some_and(char::is_alphanumeric)
+    })
+}
+
+fn contains_complete_identity(raw: &str, identity: &str) -> bool {
+    if identity.is_empty() {
+        return false;
+    }
+    let raw = raw.to_lowercase();
+    let identity = identity.to_lowercase();
+    let is_identity_char = |ch: char| ch.is_alphanumeric() || ch == '_' || ch == '-';
+    raw.match_indices(identity.as_str())
+        .any(|(start, matched)| {
+            let before = raw[..start].chars().next_back();
+            let after = raw[start + matched.len()..].chars().next();
+            !before.is_some_and(is_identity_char) && !after.is_some_and(is_identity_char)
+        })
+}
+
+/// Byte offset in `text` of the first case-insensitive match of `needle_lower`, which must
+/// already be lowercase. Lowercasing can change byte lengths, so offsets are mapped back.
+fn find_case_insensitive(text: &str, needle_lower: &str) -> Option<usize> {
+    if needle_lower.is_empty() {
+        return None;
+    }
+    let mut lowered = String::with_capacity(text.len());
+    let mut origins: Vec<usize> = Vec::with_capacity(text.len());
+    for (offset, ch) in text.char_indices() {
+        for lower in ch.to_lowercase() {
+            lowered.push(lower);
+            origins.resize(lowered.len(), offset);
+        }
+    }
+    lowered
+        .find(needle_lower)
+        .and_then(|index| origins.get(index).copied())
+}
+
+/// At most `max_bytes` of `text`, the "..." markers included, centred on the first match of
+/// the query (or of any query term) and cut on character boundaries.
+pub(super) fn excerpt(text: &str, query: &PreparedQuery, max_bytes: usize) -> String {
+    if text.len() <= max_bytes {
+        return text.to_string();
+    }
+    let marker = ELLIPSIS.len();
+    let match_start = find_case_insensitive(text, &query.raw.to_lowercase())
+        .or_else(|| {
+            query
+                .tokens
+                .iter()
+                .filter_map(|token| find_case_insensitive(text, token))
+                .min()
+        })
+        .unwrap_or(0);
+    let inner = max_bytes.saturating_sub(2 * marker);
+    let start = match_start.saturating_sub(inner / 2);
+    let (start, end) = if start == 0 {
+        // Only the end is cut.
+        (
+            0,
+            text.floor_char_boundary(max_bytes.saturating_sub(marker)),
+        )
+    } else if start + max_bytes.saturating_sub(marker) >= text.len() {
+        // Only the start is cut.
+        let kept = max_bytes.saturating_sub(marker);
+        (text.ceil_char_boundary(text.len() - kept), text.len())
+    } else {
+        let start = text.ceil_char_boundary(start);
+        (start, text.floor_char_boundary(start + inner))
+    };
+    let mut out = String::with_capacity(end - start + 2 * marker);
+    if start > 0 {
+        out.push_str(ELLIPSIS);
+    }
+    out.push_str(&text[start..end]);
+    if end < text.len() {
+        out.push_str(ELLIPSIS);
+    }
+    out
+}
+
