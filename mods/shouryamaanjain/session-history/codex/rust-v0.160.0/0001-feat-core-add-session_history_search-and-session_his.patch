new file mode 100644
index 0000000000000000000000000000000000000000..43719f934ad318d75cf755bdef3360c92fa9e7f5
--- /dev/null
+++ b/codex-rs/core/src/tools/handlers/session_history/turns.rs
@@ -0,0 +1,430 @@
+//! Rebuilds saved user/assistant turns from rollout items.
+//!
+//! A turn starts at a real user message, the same boundary Codex uses for rollback and
+//! forking, and runs until the next one. Compaction summaries and compacted checkpoints are
+//! not turns, and turns removed by `ThreadRolledBack` are dropped.
+
+use std::collections::HashMap;
+
+use codex_protocol::items::TurnItem;
+use codex_protocol::models::ContentItem;
+use codex_protocol::models::FunctionCallOutputContentItem;
+use codex_protocol::models::FunctionCallOutputPayload;
+use codex_protocol::models::LocalShellAction;
+use codex_protocol::models::MessagePhase;
+use codex_protocol::models::ResponseItem;
+use codex_protocol::protocol::EventMsg;
+use codex_rollout::RolloutItem;
+use serde::Serialize;
+use serde_json::json;
+
+use crate::context_manager::is_user_turn_boundary;
+use crate::event_mapping::parse_turn_item;
+use crate::web_search::web_search_action_detail;
+
+const MAX_RESULT_PREVIEW_BYTES: usize = 240;
+const APPLY_PATCH_TOOL_NAME: &str = "apply_patch";
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize)]
+#[serde(rename_all = "snake_case")]
+pub(super) enum TurnKind {
+    Assistant,
+    Interrupted,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize)]
+pub(super) struct ToolCallEvidence {
+    pub(super) name: String,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub(super) namespace: Option<String>,
+    pub(super) arguments: String,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize)]
+pub(super) struct ToolResultEvidence {
+    pub(super) name: String,
+    pub(super) preview: String,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize)]
+#[serde(rename_all = "snake_case")]
+pub(super) enum FileChangeKind {
+    Add,
+    Update,
+    Delete,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize)]
+pub(super) struct FileEvidence {
+    pub(super) path: String,
+    pub(super) change: FileChangeKind,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub(super) new_path: Option<String>,
+}
+
+#[derive(Clone, Debug, Default, PartialEq, Eq, Serialize)]
+pub(super) struct TurnExecution {
+    /// Assistant progress messages sent before the final answer.
+    pub(super) commentary: Vec<String>,
+    pub(super) tool_calls: Vec<ToolCallEvidence>,
+    pub(super) tool_results: Vec<ToolResultEvidence>,
+    pub(super) files: Vec<FileEvidence>,
+}
+
+/// One saved user message, the assistant's final reply to it, and what ran in between.
+#[derive(Clone, Debug, PartialEq, Eq, Serialize)]
+pub(super) struct HistoryTurn {
+    pub(super) kind: TurnKind,
+    pub(super) user: String,
+    pub(super) assistant: Option<String>,
+    pub(super) execution: TurnExecution,
+}
+
+impl HistoryTurn {
+    pub(super) fn searchable_bytes(&self) -> usize {
+        let execution = &self.execution;
+        let mut total = self.user.len();
+        total = total.saturating_add(self.assistant.as_ref().map_or(0, String::len));
+        for text in &execution.commentary {
+            total = total.saturating_add(text.len());
+        }
+        for call in &execution.tool_calls {
+            total = total.saturating_add(call.name.len() + call.arguments.len());
+        }
+        for result in &execution.tool_results {
+            total = total.saturating_add(result.name.len() + result.preview.len());
+        }
+        for file in &execution.files {
+            total = total.saturating_add(file.path.len());
+            total = total.saturating_add(file.new_path.as_ref().map_or(0, String::len));
+        }
+        total
+    }
+}
+
+struct TurnBuilder {
+    retained: bool,
+    user: String,
+    interrupted: bool,
+    assistant_messages: Vec<(String, Option<MessagePhase>)>,
+    execution: TurnExecution,
+    call_names: HashMap<String, String>,
+}
+
+impl TurnBuilder {
+    fn new(user: String, retained: bool) -> Self {
+        Self {
+            retained,
+            user: if retained { user } else { String::new() },
+            interrupted: false,
+            assistant_messages: Vec::new(),
+            execution: TurnExecution::default(),
+            call_names: HashMap::new(),
+        }
+    }
+
+    fn push_call(&mut self, call_id: Option<&str>, call: ToolCallEvidence) {
+        if let Some(call_id) = call_id {
+            self.call_names
+                .insert(call_id.to_string(), call.name.clone());
+        }
+        self.execution.tool_calls.push(call);
+    }
+
+    fn push_result(&mut self, call_id: Option<&str>, name: Option<&str>, preview: String) {
+        let name = call_id
+            .and_then(|call_id| self.call_names.get(call_id).cloned())
+            .or_else(|| name.map(str::to_string))
+            .unwrap_or_else(|| "unknown".to_string());
+        self.execution
+            .tool_results
+            .push(ToolResultEvidence { name, preview });
+    }
+
+    fn absorb(&mut self, item: &ResponseItem) {
+        if !self.retained {
+            return;
+        }
+        match item {
+            ResponseItem::Message {
+                role,
+                content,
+                phase,
+                ..
+            } if role == "assistant" => {
+                let text = message_text(content);
+                if !text.is_empty() {
+                    self.assistant_messages.push((text, phase.clone()));
+                }
+            }
+            ResponseItem::FunctionCall {
+                name,
+                namespace,
+                arguments,
+                call_id,
+                ..
+            } => {
+                if name == APPLY_PATCH_TOOL_NAME
+                    && let Ok(value) = serde_json::from_str::<serde_json::Value>(arguments)
+                    && let Some(patch) = value.get("input").and_then(serde_json::Value::as_str)
+                {
+                    self.execution.files.extend(patch_files(patch));
+                }
+                self.push_call(
+                    Some(call_id),
+                    ToolCallEvidence {
+                        name: name.clone(),
+                        namespace: namespace.clone(),
+                        arguments: arguments.clone(),
+                    },
+                );
+            }
+            ResponseItem::CustomToolCall {
+                name,
+                namespace,
+                input,
+                call_id,
+                ..
+            } => {
+                if name == APPLY_PATCH_TOOL_NAME {
+                    self.execution.files.extend(patch_files(input));
+                }
+                self.push_call(
+                    Some(call_id),
+                    ToolCallEvidence {
+                        name: name.clone(),
+                        namespace: namespace.clone(),
+                        arguments: input.clone(),
+                    },
+                );
+            }
+            ResponseItem::LocalShellCall {
+                call_id, action, ..
+            } => {
+                let LocalShellAction::Exec(exec) = action;
+                self.push_call(
+                    call_id.as_deref(),
+                    ToolCallEvidence {
+                        name: "local_shell".to_string(),
+                        namespace: None,
+                        arguments: json!({ "command": exec.command }).to_string(),
+                    },
+                );
+            }
+            ResponseItem::ToolSearchCall {
+                call_id, arguments, ..
+            } => self.push_call(
+                call_id.as_deref(),
+                ToolCallEvidence {
+                    name: "tool_search".to_string(),
+                    namespace: None,
+                    arguments: arguments.to_string(),
+                },
+            ),
+            ResponseItem::WebSearchCall { action, .. } => self.push_call(
+                /*call_id*/ None,
+                ToolCallEvidence {
+                    name: "web_search".to_string(),
+                    namespace: None,
+                    arguments: action
+                        .as_ref()
+                        .map(web_search_action_detail)
+                        .unwrap_or_default(),
+                },
+            ),
+            ResponseItem::FunctionCallOutput {
+                call_id,
+                name,
+                output,
+                ..
+            } => self.push_result(call_id.as_deref(), name.as_deref(), output_preview(output)),
+            ResponseItem::CustomToolCallOutput {
+                call_id,
+                name,
+                output,
+                ..
+            } => self.push_result(Some(call_id), name.as_deref(), output_preview(output)),
+            ResponseItem::ToolSearchOutput { call_id, tools, .. } => self.push_result(
+                call_id.as_deref(),
+                Some("tool_search"),
+                bounded_preview(&serde_json::Value::Array(tools.clone()).to_string()),
+            ),
+            // Reasoning, compaction checkpoints, inter-agent messages, configuration updates and
+            // non-assistant messages carry no user-visible evidence for a turn.
+            _ => {}
+        }
+    }
+
+    fn finish(self) -> HistoryTurn {
+        let Self {
+            user,
+            interrupted,
+            mut assistant_messages,
+            mut execution,
+            ..
+        } = self;
+        let final_index = assistant_messages
+            .iter()
+            .rposition(|(_, phase)| !matches!(phase, Some(MessagePhase::Commentary)));
+        let assistant = final_index.map(|index| assistant_messages.remove(index).0);
+        execution.commentary = assistant_messages
+            .into_iter()
+            .map(|(text, _)| text)
+            .collect();
+        HistoryTurn {
+            kind: if interrupted {
+                TurnKind::Interrupted
+            } else {
+                TurnKind::Assistant
+            },
+            user,
+            assistant,
+            execution,
+        }
+    }
+}
+
+/// Which turns keep their content; the others are only counted, so indices stay the same.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(super) enum Retain {
+    All,
+    Only(usize),
+}
+
+/// Rebuilds the saved turns of one rollout, oldest first, one rollout item at a time.
+pub(super) struct TurnExtractor {
+    retain: Retain,
+    turns: Vec<TurnBuilder>,
+    current: Option<usize>,
+}
+
+impl TurnExtractor {
+    pub(super) fn new(retain: Retain) -> Self {
+        Self {
+            retain,
+            turns: Vec::new(),
+            current: None,
+        }
+    }
+
+    pub(super) fn push(&mut self, item: &RolloutItem) {
+        match item {
+            RolloutItem::ResponseItem(envelope) => {
+                if let Some(user) = real_user_message(&envelope.item) {
+                    let index = self.turns.len();
+                    let retained = match self.retain {
+                        Retain::All => true,
+                        Retain::Only(wanted) => wanted == index,
+                    };
+                    self.turns.push(TurnBuilder::new(user, retained));
+                    self.current = Some(index);
+                } else if let Some(turn) = self.current.and_then(|index| self.turns.get_mut(index))
+                {
+                    turn.absorb(&envelope.item);
+                }
+            }
+            RolloutItem::EventMsg(EventMsg::ThreadRolledBack(rollback)) => {
+                let removed = usize::try_from(rollback.num_turns).unwrap_or(usize::MAX);
+                self.turns
+                    .truncate(self.turns.len().saturating_sub(removed));
+                self.current = None;
+            }
+            RolloutItem::EventMsg(EventMsg::TurnAborted(_)) => {
+                if let Some(turn) = self.current.and_then(|index| self.turns.get_mut(index)) {
+                    turn.interrupted = true;
+                }
+            }
+            // Compacted checkpoints hold summaries and replacement history, not new turns.
+            _ => {}
+        }
+    }
+
+    pub(super) fn finish(self) -> Vec<HistoryTurn> {
+        self.turns.into_iter().map(TurnBuilder::finish).collect()
+    }
+}
+
+fn real_user_message(item: &ResponseItem) -> Option<String> {
+    if !matches!(item, ResponseItem::Message { role, .. } if role == "user")
+        || !is_user_turn_boundary(item)
+    {
+        return None;
+    }
+    match parse_turn_item(item) {
+        Some(TurnItem::UserMessage(message)) => Some(message.message()),
+        _ => None,
+    }
+}
+
+fn message_text(content: &[ContentItem]) -> String {
+    content
+        .iter()
+        .filter_map(|item| match item {
+            ContentItem::InputText { text } | ContentItem::OutputText { text } => {
+                Some(text.as_str())
+            }
+            ContentItem::InputImage { .. } | ContentItem::InputAudio { .. } => None,
+        })
+        .collect::<Vec<_>>()
+        .join("")
+}
+
+fn output_preview(output: &FunctionCallOutputPayload) -> String {
+    if let Some(text) = output.text_content() {
+        return bounded_preview(text);
+    }
+    let text = output
+        .content_items()
+        .unwrap_or_default()
+        .iter()
+        .filter_map(|item| match item {
+            FunctionCallOutputContentItem::InputText { text } => Some(text.as_str()),
+            _ => None,
+        })
+        .collect::<Vec<_>>()
+        .join("\n");
+    bounded_preview(&text)
+}
+
+fn bounded_preview(text: &str) -> String {
+    truncate_with_ellipsis(text, MAX_RESULT_PREVIEW_BYTES)
+}
+
+/// Cuts `text` to at most `max_bytes` bytes on a character boundary, marking the cut.
+pub(super) fn truncate_with_ellipsis(text: &str, max_bytes: usize) -> String {
+    if text.len() <= max_bytes {
+        return text.to_string();
+    }
+    format!("{}...", &text[..text.floor_char_boundary(max_bytes)])
+}
+
+fn patch_files(patch: &str) -> Vec<FileEvidence> {
+    let mut files: Vec<FileEvidence> = Vec::new();
+    for line in patch.lines() {
+        let line = line.trim_end();
+        if let Some(path) = line.strip_prefix("*** Add File: ") {
+            files.push(file_evidence(path, FileChangeKind::Add));
+        } else if let Some(path) = line.strip_prefix("*** Update File: ") {
+            files.push(file_evidence(path, FileChangeKind::Update));
+        } else if let Some(path) = line.strip_prefix("*** Delete File: ") {
+            files.push(file_evidence(path, FileChangeKind::Delete));
+        } else if let Some(new_path) = line.strip_prefix("*** Move to: ")
+            && let Some(file) = files.last_mut()
+        {
+            file.new_path = Some(new_path.trim().to_string());
+        }
+    }
+    files
+}
+
+fn file_evidence(path: &str, change: FileChangeKind) -> FileEvidence {
+    FileEvidence {
+        path: path.trim().to_string(),
+        change,
+        new_path: None,
+    }
+}
+
+#[cfg(test)]
+#[path = "turns_tests.rs"]
+mod tests;
