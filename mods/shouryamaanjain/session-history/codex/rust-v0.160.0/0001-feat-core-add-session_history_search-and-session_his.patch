+/// The current session with one "cobalt" turn of exactly `bytes` searchable bytes, spread
+/// over a few tool calls.
+fn turn_of_bytes(fixture: &Fixture, bytes: usize) -> Vec<Value> {
+    let question = "cobalt question";
+    let answer = "ok";
+    let calls = 3;
+    let name = "exec_command";
+    let arguments = bytes - question.len() - answer.len() - calls * name.len();
+    let mut lines = vec![
+        session_meta(fixture.current, &fixture.project_a, cli()),
+        user(question),
+        user_event(question),
+    ];
+    for call in 0..calls {
+        let size = arguments / calls + usize::from(call < arguments % calls);
+        lines.push(function_call(
+            name,
+            &"y".repeat(size),
+            &format!("call-{call}"),
+        ));
+    }
+    lines.push(assistant(answer, "final_answer"));
+    lines
+}
+
+fn parse_json(text: &str) -> Value {
+    serde_json::from_str(text).expect("tool output is JSON")
+}
+
+fn hit_identities(output: &Value) -> Vec<(String, String)> {
+    output["hits"]
+        .as_array()
+        .expect("hits array")
+        .iter()
+        .map(|hit| {
+            (
+                hit["session_id"].as_str().expect("session id").to_string(),
+                hit["session_relation"]
+                    .as_str()
+                    .expect("relation")
+                    .to_string(),
+            )
+        })
+        .collect()
+}
+
+async fn reference_for(scope: &HistoryScope, query: &str, session: ThreadId) -> String {
+    let output = parse_json(&search(scope, query, MAX_LIMIT).await.expect("search"));
+    output["hits"]
+        .as_array()
+        .expect("hits array")
+        .iter()
+        .find(|hit| hit["session_id"] == session.to_string())
+        .and_then(|hit| hit["reference"].as_str())
+        .expect("hit for session")
+        .to_string()
+}
