@@ -0,0 +1,471 @@
+//! Bounded search and exact reads over the saved rollouts of the current project.
+//!
+//! The project is the current session's working directory, the same scope `codex resume`
+//! uses by default. Only the host decides that scope; model arguments cannot widen it.
+
+use std::collections::HashSet;
+use std::path::Path;
+use std::path::PathBuf;
+
+use codex_protocol::ThreadId;
+use codex_protocol::protocol::EventMsg;
+use codex_rollout::RolloutItem;
+use codex_rollout::RolloutRecorder;
+use codex_rollout::ThreadSortKey;
+use codex_utils_path::paths_match_after_normalization;
+use serde::Serialize;
+
+use super::score::PreparedQuery;
+use super::score::Score;
+use super::score::excerpt;
+use super::score::score_turn;
+use super::turns::HistoryTurn;
+use super::turns::Retain;
+use super::turns::TurnExecution;
+use super::turns::TurnExtractor;
+use super::turns::truncate_with_ellipsis;
+
+pub(super) const MAX_QUERY_BYTES: usize = 512;
+pub(super) const MAX_REFERENCE_BYTES: usize = 512;
+pub(super) const DEFAULT_LIMIT: usize = 8;
+pub(super) const MAX_LIMIT: usize = 20;
+const MAX_SESSIONS_SCANNED: usize = 100;
+const MAX_TURNS_SCANNED: usize = 10_000;
+const MAX_SEARCHABLE_BYTES: usize = 2 * 1024 * 1024;
+pub(super) const READ_BUDGET_BYTES: u64 = 128 * 1024 * 1024;
+const MAX_EXCERPT_BYTES: usize = 320;
+const MAX_EVIDENCE_ENTRIES: usize = 50;
+const MAX_EVIDENCE_TEXT_BYTES: usize = 2_000;
+const REFERENCE_PREFIX: &str = "cxhr1";
+const REFERENCE_CONTEXT: &str = "codex.session-history-reference.v1";
+const WORKSPACE_SCOPE: &str = "same_project";
+const CONTENT_AUTHORITY: &str = "untrusted_historical_context";
+const UNAVAILABLE: &str = "session history reference is unavailable: it is not an exact session_history_search reference for a saved turn of this project, or the turn has changed";
+
+/// The host-owned boundary of a history search: which saved sessions count as this project.
+pub(super) struct HistoryScope {
+    pub(super) codex_home: PathBuf,
+    pub(super) project_root: PathBuf,
+    pub(super) current: CurrentSession,
+    /// Rollout file bytes one search may load from sessions other than the current one.
+    pub(super) read_budget_bytes: u64,
+}
+
+pub(super) struct CurrentSession {
+    pub(super) id: ThreadId,
+    /// `None` for an ephemeral fork, which shares its saved parent's tools but is not saved.
+    pub(super) rollout_path: Option<PathBuf>,
+    /// The turn running the tool; it is still in progress, so it is not saved history yet.
+    pub(super) active_turn_id: String,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize)]
+#[serde(rename_all = "snake_case")]
+pub(super) enum Relation {
+    Current,
+    Other,
+}
+
+struct ScopedSession {
+    id: ThreadId,
+    relation: Relation,
+    turns: Vec<HistoryTurn>,
+}
+
+#[derive(Serialize)]
+struct SearchHit {
+    reference: String,
+    session_id: String,
+    session_relation: Relation,
+    excerpt: String,
+    #[serde(skip)]
+    score: Score,
+}
+
+#[derive(Serialize)]
+struct SearchOutput {
+    kind: &'static str,
+    workspace_scope: &'static str,
+    content_authority: &'static str,
+    hits: Vec<SearchHit>,
+    truncated: bool,
+}
+
+#[derive(Serialize)]
+struct Conversation<'a> {
+    user: &'a str,
+    assistant: Option<&'a str>,
+}
+
+#[derive(Serialize)]
+struct RecordOutput<'a> {
+    kind: &'static str,
+    workspace_scope: &'static str,
+    content_authority: &'static str,
+    session_id: String,
+    session_relation: Relation,
+    turn_kind: super::turns::TurnKind,
+    conversation: Conversation<'a>,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    execution: Option<ExecutionOutput>,
+}
+
+#[derive(Serialize)]
+struct ExecutionOutput {
+    #[serde(flatten)]
+    evidence: TurnExecution,
+    truncated: bool,
+}
+
+/// Searches saved same-project turns, newest sessions and newest turns first.
+pub(super) async fn search(
+    scope: &HistoryScope,
+    query: &str,
+    limit: usize,
+) -> Result<String, String> {
+    let query = query.trim();
+    if query.is_empty() {
+        return Err("session_history_search field \"query\" must not be empty".to_string());
+    }
+    if query.len() > MAX_QUERY_BYTES {
+        return Err(format!(
+            "session_history_search field \"query\" must be at most {MAX_QUERY_BYTES} bytes"
+        ));
+    }
+    if !(1..=MAX_LIMIT).contains(&limit) {
+        return Err(format!(
+            "session_history_search field \"limit\" must be an integer from 1 to {MAX_LIMIT}"
+        ));
+    }
+    let query = PreparedQuery::new(query);
+    let (paths, mut truncated) = candidate_rollouts(scope).await;
+
+    let mut hits: Vec<SearchHit> = Vec::new();
+    let mut budget_left = scope.read_budget_bytes;
+    let mut turns_scanned = 0usize;
+    let mut searchable_bytes = 0usize;
+    'sessions: for path in paths {
+        if turns_scanned >= MAX_TURNS_SCANNED || searchable_bytes >= MAX_SEARCHABLE_BYTES {
+            truncated = true;
+            break;
+        }
+        // The current session is always searched; other rollouts must fit the byte budget,
+        // checked before they are loaded.
+        if scope.current.rollout_path.as_ref() != Some(&path) {
+            if budget_left == 0 {
+                truncated = true;
+                break;
+            }
+            let Some(size) = rollout_size(&path).await else {
+                truncated = true;
+                continue;
+            };
+            if size > budget_left {
+                truncated = true;
+                continue;
+            }
+            budget_left -= size;
+        }
+        let Ok(Some(session)) = load_scoped_session(scope, &path, Retain::All).await else {
+            truncated = true;
+            continue;
+        };
+        let session_id = session.id.to_string();
+        for (turn_index, turn) in session.turns.iter().enumerate().rev() {
+            if turns_scanned >= MAX_TURNS_SCANNED {
+                truncated = true;
+                break 'sessions;
+            }
+            turns_scanned += 1;
+            let turn_bytes = turn.searchable_bytes();
+            if turn_bytes > MAX_SEARCHABLE_BYTES - searchable_bytes {
+                truncated = true;
+                continue;
+            }
+            searchable_bytes += turn_bytes;
+            let Some(scored) = score_turn(&query, &session_id, turn) else {
+                continue;
+            };
+            if hits.len() >= limit {
+                truncated = true;
+                if hits.last().is_some_and(|last| scored.score <= last.score) {
+                    continue;
+                }
+            }
+            // Ties keep scan order, so newer turns rank first.
+            let position = hits
+                .iter()
+                .position(|hit| scored.score > hit.score)
+                .unwrap_or(hits.len());
+            hits.insert(
+                position,
+                SearchHit {
+                    reference: reference(scope, &session_id, turn_index, turn),
+                    session_id: session_id.clone(),
+                    session_relation: session.relation,
+                    excerpt: excerpt(scored.excerpt_source, &query, MAX_EXCERPT_BYTES),
+                    score: scored.score,
+                },
+            );
+            hits.truncate(limit);
+        }
+    }
+
+    serde_json::to_string(&SearchOutput {
+        kind: "session_history_search",
+        workspace_scope: WORKSPACE_SCOPE,
+        content_authority: CONTENT_AUTHORITY,
+        hits,
+        truncated,
+    })
+    .map_err(|err| format!("failed to render session history search: {err}"))
+}
+
+/// Reads one saved turn by an exact reference from `search`.
+pub(super) async fn read(
+    scope: &HistoryScope,
+    reference_text: &str,
+    include_execution: bool,
+) -> Result<String, String> {
+    let reference_text = reference_text.trim();
+    let (session_id, turn_index) = parse_reference(reference_text).ok_or_else(|| {
+        format!(
+            "session_history_read field \"reference\" must be an exact session_history_search reference ({REFERENCE_PREFIX}:<session>:<turn>:<digest>)"
+        )
+    })?;
+    let path = if session_id == scope.current.id {
+        scope.current.rollout_path.clone()
+    } else {
+        codex_rollout::find_thread_path_by_id_str(
+            &scope.codex_home,
+            &session_id.to_string(),
+            /*state_db_ctx*/ None,
+        )
+        .await
+        .ok()
+        .flatten()
+    };
+    let path = path.ok_or_else(|| UNAVAILABLE.to_string())?;
+    let session = load_scoped_session(scope, &path, Retain::Only(turn_index))
+        .await?
+        .filter(|session| session.id == session_id)
+        .ok_or_else(|| UNAVAILABLE.to_string())?;
+    let turn = session
+        .turns
+        .get(turn_index)
+        .ok_or_else(|| UNAVAILABLE.to_string())?;
+    let session_id = session.id.to_string();
+    if reference(scope, &session_id, turn_index, turn) != reference_text {
+        return Err(UNAVAILABLE.to_string());
+    }
+
+    serde_json::to_string(&RecordOutput {
+        kind: "session_history_record",
+        workspace_scope: WORKSPACE_SCOPE,
+        content_authority: CONTENT_AUTHORITY,
+        session_id,
+        session_relation: session.relation,
+        turn_kind: turn.kind,
+        conversation: Conversation {
+            user: &turn.user,
+            assistant: turn.assistant.as_deref(),
+        },
+        execution: include_execution.then(|| bounded_execution(&turn.execution)),
+    })
+    .map_err(|err| format!("failed to render session history record: {err}"))
+}
+
+/// The current session's rollout first, then this project's other saved sessions by recency.
+async fn candidate_rollouts(scope: &HistoryScope) -> (Vec<PathBuf>, bool) {
+    let mut paths: Vec<PathBuf> = scope.current.rollout_path.iter().cloned().collect();
+    let mut seen = HashSet::from([scope.current.id]);
+    let page = codex_rollout::get_threads(
+        &scope.codex_home,
+        MAX_SESSIONS_SCANNED,
+        /*cursor*/ None,
+        ThreadSortKey::UpdatedAt,
+        /*allowed_sources*/ &[],
+        /*model_providers*/ None,
+        Some(std::slice::from_ref(&scope.project_root)),
+        /*default_provider*/ "",
+    )
+    .await;
+    let Ok(page) = page else {
+        return (paths, true);
+    };
+    let mut truncated = page.next_cursor.is_some() || page.reached_scan_cap;
+    for item in page.items {
+        if item
+            .source
+            .as_ref()
+            .is_some_and(codex_protocol::protocol::SessionSource::is_non_root_agent)
+        {
+            continue;
+        }
+        // A reverted thread keeps its id across rollout files; the newest one is the thread.
+        if item.thread_id.is_some_and(|id| !seen.insert(id)) {
+            continue;
+        }
+        paths.push(item.path);
+    }
+    if paths.len() > MAX_SESSIONS_SCANNED {
+        paths.truncate(MAX_SESSIONS_SCANNED);
+        truncated = true;
+    }
+    (paths, truncated)
+}
+
+/// Size on disk of the rollout at `path`, plain or compressed.
+async fn rollout_size(path: &Path) -> Option<u64> {
+    let existing = codex_rollout::existing_rollout_path(path).await?;
+    tokio::fs::metadata(existing)
+        .await
+        .ok()
+        .map(|metadata| metadata.len())
+}
+
+/// Loads a rollout whole with Codex's own reader, as resume and fork do, if it belongs to
+/// this project: the running session, or a saved root session recorded with the project's
+/// working directory. The scope is checked from the rollout's session meta (its head) before
+/// the rest is read. `Ok(None)` means out of scope; `Err` means an in-scope rollout failed to
+/// load.
+async fn load_scoped_session(
+    scope: &HistoryScope,
+    path: &Path,
+    retain: Retain,
+) -> Result<Option<ScopedSession>, String> {
+    let Ok(head) = codex_rollout::read_session_meta_line(path).await else {
+        return Ok(None);
+    };
+    let meta = head.meta;
+    let relation = if meta.id == scope.current.id {
+        Relation::Current
+    } else {
+        Relation::Other
+    };
+    if relation == Relation::Other
+        && (meta.source.is_non_root_agent()
+            || !paths_match_after_normalization(&meta.cwd, &scope.project_root))
+    {
+        return Ok(None);
+    }
+    let (items, thread_id, _parse_errors) = RolloutRecorder::load_rollout_items(path)
+        .await
+        .map_err(|err| format!("failed to load saved session {}: {err}", meta.id))?;
+    // The file could have been replaced between the two reads.
+    if thread_id != Some(meta.id) {
+        return Ok(None);
+    }
+    let mut extractor = TurnExtractor::new(retain);
+    for item in &items {
+        // The running turn is not saved history yet.
+        if let RolloutItem::EventMsg(EventMsg::TurnStarted(event)) = item
+            && relation == Relation::Current
+            && event.turn_id == scope.current.active_turn_id
+        {
+            break;
+        }
+        extractor.push(item);
+    }
+    Ok(Some(ScopedSession {
+        id: meta.id,
+        relation,
+        turns: extractor.finish(),
+    }))
+}
+
+/// `cxhr1:<session id>:<turn index>:<sha256>`, where the digest binds the project, the
+/// session, the turn's position and its content.
+fn reference(
+    scope: &HistoryScope,
+    session_id: &str,
+    turn_index: usize,
+    turn: &HistoryTurn,
+) -> String {
+    let content = serde_json::to_string(turn).unwrap_or_default();
+    let preimage = format!(
+        "{REFERENCE_CONTEXT}\0{}\0{session_id}\0{turn_index}\0{content}",
+        scope.project_root.display()
+    );
+    // SHA-256 of the JSON-encoded preimage, through the hashing helper Codex already ships.
+    let digest = codex_config::version_for_toml(&toml::Value::String(preimage));
+    let digest = digest.strip_prefix("sha256:").unwrap_or(&digest);
+    format!("{REFERENCE_PREFIX}:{session_id}:{turn_index}:{digest}")
+}
+
+fn parse_reference(reference: &str) -> Option<(ThreadId, usize)> {
+    if reference.is_empty() || reference.len() > MAX_REFERENCE_BYTES {
+        return None;
+    }
+    let mut fields = reference.split(':');
+    let (Some(prefix), Some(session_id), Some(turn_index), Some(digest), None) = (
+        fields.next(),
+        fields.next(),
+        fields.next(),
+        fields.next(),
+        fields.next(),
+    ) else {
+        return None;
+    };
+    let digest_ok = digest.len() == 64
+        && digest
+            .bytes()
+            .all(|byte| byte.is_ascii_digit() || (b'a'..=b'f').contains(&byte));
+    if prefix != REFERENCE_PREFIX || !digest_ok {
+        return None;
+    }
+    let session_id = ThreadId::from_string(session_id).ok()?;
+    let turn_index = turn_index.parse::<usize>().ok()?;
+    Some((session_id, turn_index))
+}
+
+fn bounded_execution(execution: &TurnExecution) -> ExecutionOutput {
+    let mut truncated = false;
+    let mut bound_text = |text: &str| {
+        if text.len() > MAX_EVIDENCE_TEXT_BYTES {
+            truncated = true;
+        }
+        truncate_with_ellipsis(text, MAX_EVIDENCE_TEXT_BYTES)
+    };
+    let mut evidence = TurnExecution {
+        commentary: execution
+            .commentary
+            .iter()
+            .take(MAX_EVIDENCE_ENTRIES)
+            .map(|text| bound_text(text))
+            .collect(),
+        tool_calls: execution
+            .tool_calls
+            .iter()
+            .take(MAX_EVIDENCE_ENTRIES)
+            .cloned()
+            .collect(),
+        tool_results: execution
+            .tool_results
+            .iter()
+            .take(MAX_EVIDENCE_ENTRIES)
+            .cloned()
+            .collect(),
+        files: execution
+            .files
+            .iter()
+            .take(MAX_EVIDENCE_ENTRIES)
+            .cloned()
+            .collect(),
+    };
+    for call in &mut evidence.tool_calls {
+        call.arguments = bound_text(&call.arguments);
+    }
+    let entries_cut = execution.commentary.len() > MAX_EVIDENCE_ENTRIES
+        || execution.tool_calls.len() > MAX_EVIDENCE_ENTRIES
+        || execution.tool_results.len() > MAX_EVIDENCE_ENTRIES
+        || execution.files.len() > MAX_EVIDENCE_ENTRIES;
+    ExecutionOutput {
+        evidence,
+        truncated: truncated || entries_cut,
+    }
+}
