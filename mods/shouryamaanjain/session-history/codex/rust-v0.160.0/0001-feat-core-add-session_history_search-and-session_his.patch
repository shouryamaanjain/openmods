+#[tokio::test]
+async fn tampered_changed_or_foreign_references_are_unavailable() {
+    let fixture = fixture();
+    let scope = fixture.scope();
+    let reference = reference_for(&scope, "cobalt", fixture.older).await;
+    let unavailable = Err(UNAVAILABLE.to_string());
+
+    let mut tampered = reference.clone();
+    let last = tampered.pop().expect("digest char");
+    tampered.push(if last == '0' { '1' } else { '0' });
+    assert_eq!(
+        read(&scope, &tampered, /*include_execution*/ false).await,
+        unavailable
+    );
+
+    let wrong_index = reference.replacen(":0:", ":1:", 1);
+    assert_eq!(
+        read(&scope, &wrong_index, /*include_execution*/ false).await,
+        unavailable
+    );
+
+    // The same session read from another project's scope.
+    let mut foreign_scope = fixture.scope();
+    foreign_scope.project_root = fixture.project_b.clone();
+    assert_eq!(
+        read(&foreign_scope, &reference, /*include_execution*/ false).await,
+        unavailable
+    );
+
+    // A reference minted for project B's session cannot be read from project A.
+    let outside_reference = reference_for(&foreign_scope, "cobalt", fixture.outside).await;
+    assert_eq!(
+        read(&scope, &outside_reference, /*include_execution*/ false).await,
+        unavailable
+    );
+
+    // Changing the saved turn invalidates its old reference.
+    let path = codex_rollout::find_thread_path_by_id_str(
+        &fixture.codex_home,
+        &fixture.older.to_string(),
+        /*state_db_ctx*/ None,
