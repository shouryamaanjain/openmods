+//! Rollout JSONL fixtures in the on-disk format, shared by the session history tests.
+
+use std::io::Write;
+use std::path::Path;
+use std::path::PathBuf;
+use std::time::Duration;
+use std::time::SystemTime;
+
+use codex_protocol::ThreadId;
+use codex_rollout::RolloutItem;
+use serde_json::Value;
+use serde_json::json;
+
+pub(super) fn line(kind: &str, payload: Value) -> Value {
+    json!({ "timestamp": "2026-01-01T00:00:00.000Z", "type": kind, "payload": payload })
+}
+
+pub(super) fn session_meta(id: ThreadId, cwd: &Path, source: Value) -> Value {
+    line(
+        "session_meta",
+        json!({
+            "session_id": id.to_string(),
+            "id": id.to_string(),
+            "timestamp": "2026-01-01T00:00:00.000Z",
+            "cwd": cwd,
+            "originator": "test",
+            "cli_version": "test",
+            "source": source,
+        }),
+    )
+}
+
+pub(super) fn user(text: &str) -> Value {
+    line(
+        "response_item",
+        json!({ "type": "message", "role": "user", "content": [{ "type": "input_text", "text": text }] }),
+    )
+}
+
+/// The legacy user event Codex writes next to each user message; listings need one.
+pub(super) fn user_event(text: &str) -> Value {
+    line(
+        "event_msg",
+        json!({ "type": "user_message", "message": text, "kind": "plain" }),
+    )
+}
+
+pub(super) fn assistant(text: &str, phase: &str) -> Value {
+    line(
+        "response_item",
+        json!({
+            "type": "message",
+            "role": "assistant",
+            "content": [{ "type": "output_text", "text": text }],
+            "phase": phase,
+        }),
+    )
+}
+
+pub(super) fn function_call(name: &str, arguments: &str, call_id: &str) -> Value {
+    line(
+        "response_item",
+        json!({ "type": "function_call", "name": name, "arguments": arguments, "call_id": call_id }),
+    )
+}
+
+pub(super) fn function_output(call_id: &str, output: &str) -> Value {
+    line(
+        "response_item",
+        json!({ "type": "function_call_output", "call_id": call_id, "output": output }),
+    )
+}
+
+pub(super) fn custom_call(name: &str, input: &str, call_id: &str) -> Value {
+    line(
+        "response_item",
+        json!({ "type": "custom_tool_call", "name": name, "input": input, "call_id": call_id }),
+    )
+}
+
+pub(super) fn custom_output(call_id: &str, output: &str) -> Value {
+    line(
+        "response_item",
+        json!({ "type": "custom_tool_call_output", "call_id": call_id, "output": output }),
+    )
+}
+
+pub(super) fn event(payload: Value) -> Value {
+    line("event_msg", payload)
+}
+
+pub(super) fn compacted(message: &str) -> Value {
+    line("compacted", json!({ "message": message }))
+}
+
+pub(super) fn parse(lines: &[Value]) -> Vec<RolloutItem> {
+    lines
+        .iter()
+        .map(|line| {
+            codex_rollout::parse_rollout_line(&line.to_string())
+                .expect("fixture line should parse")
+                .item
+        })
+        .collect()
+}
+
+/// Writes a rollout under `codex_home/sessions`, modified `age_secs` seconds before now.
+pub(super) fn write_rollout(
+    codex_home: &Path,
+    id: ThreadId,
+    age_secs: u64,
+    lines: &[Value],
+) -> PathBuf {
+    let dir = codex_home.join("sessions/2026/01/01");
+    std::fs::create_dir_all(&dir).expect("create sessions dir");
+    let path = dir.join(format!("rollout-2026-01-01T00-00-00-{id}.jsonl"));
+    let mut file = std::fs::File::create(&path).expect("create rollout");
+    for line in lines {
+        writeln!(file, "{line}").expect("write rollout line");
+    }
+    let modified = SystemTime::now() - Duration::from_secs(age_secs);
+    file.set_modified(modified).expect("set rollout mtime");
+    path
+}
