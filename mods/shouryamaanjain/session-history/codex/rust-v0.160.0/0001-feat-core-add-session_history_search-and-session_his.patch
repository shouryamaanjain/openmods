+use super::super::turns::HistoryTurn;
+use super::super::turns::ToolCallEvidence;
+use super::super::turns::TurnExecution;
+use super::super::turns::TurnKind;
+use super::*;
+
+fn turn(user: &str, assistant: Option<&str>) -> HistoryTurn {
+    HistoryTurn {
+        kind: TurnKind::Assistant,
+        user: user.to_string(),
+        assistant: assistant.map(str::to_string),
+        execution: TurnExecution::default(),
+    }
+}
+
+#[test]
+fn ranking_prefers_identity_then_more_terms_then_user_and_assistant_text() {
+    let query = PreparedQuery::new("cobalt deploy");
+    let both_strong = turn("cobalt deploy", /*assistant*/ None);
+    let one_strong = turn("cobalt only", /*assistant*/ None);
+    let mut one_strong_one_weak = turn("cobalt", /*assistant*/ None);
+    one_strong_one_weak
+        .execution
+        .tool_calls
+        .push(ToolCallEvidence {
+            name: "exec_command".to_string(),
+            namespace: None,
+            arguments: "./deploy.sh".to_string(),
+        });
+    let unrelated = turn("nothing here", /*assistant*/ None);
+
+    let score = |turn: &HistoryTurn| score_turn(&query, "session-a", turn).map(|hit| hit.score);
+
+    assert_eq!(score(&unrelated), None);
+    assert!(score(&both_strong) > score(&one_strong_one_weak));
+    assert!(score(&one_strong_one_weak) > score(&one_strong));
+
+    let identity_query = PreparedQuery::new("session-a");
+    let identity = score_turn(&identity_query, "session-a", &unrelated).map(|hit| hit.score);
+    assert!(identity > score(&both_strong));
+}
+
+#[test]
+fn strong_fields_need_whole_words_and_repeats_score_once() {
+    let query = PreparedQuery::new("alpha beta");
+    let repetitive = turn("alpha beta", Some("alpha beta alpha"));
+    let concise = turn("alpha", Some("beta"));
+    let partial_word = turn("alphabet", /*assistant*/ None);
+
+    let score = |turn: &HistoryTurn| score_turn(&query, "id", turn).map(|hit| hit.score);
+
+    assert_eq!(score(&repetitive), score(&concise));
+    assert_eq!(score(&partial_word), None);
+}
+
+#[test]
+fn excerpt_source_is_the_first_matching_field() {
+    let query = PreparedQuery::new("cobalt");
+    let hit = turn("unrelated", Some("We picked COBALT."));
+
+    let scored = score_turn(&query, "id", &hit).expect("assistant text matches");
+
+    assert_eq!(scored.excerpt_source, "We picked COBALT.");
+}
+
+#[test]
+fn excerpt_is_bounded_centred_and_cut_on_character_boundaries() {
+    let text = format!("{}cobalt decision{}", "é".repeat(300), "x".repeat(600));
+    let query = PreparedQuery::new("cobalt decision");
+
+    let cut = excerpt(&text, &query, 320);
+
+    assert!(cut.starts_with("..."));
+    assert!(cut.ends_with("..."));
+    assert!(cut.len() <= 320);
+    assert!(cut.contains("cobalt decision"));
+    assert_eq!(excerpt("short", &query, 320), "short");
+
+    let head = excerpt(&format!("cobalt {}", "é".repeat(400)), &query, 320);
+    assert!(!head.starts_with("...") && head.ends_with("..."));
+    assert!(head.len() <= 320);
+    let tail = excerpt(&format!("{} cobalt", "é".repeat(400)), &query, 320);
+    assert!(tail.starts_with("...") && !tail.ends_with("..."));
+    assert!(tail.len() <= 320);
+    assert!(tail.ends_with("cobalt"));
+}
+
+#[test]
+fn execution_matches_score_but_excerpt_the_user_text() {
+    let query = PreparedQuery::new("deploy.toml");
+    let mut hit = turn("check the config", Some("Done."));
+    hit.execution
+        .commentary
+        .push("Reading deploy.toml now.".to_string());
+    hit.execution.tool_calls.push(ToolCallEvidence {
+        name: "exec_command".to_string(),
+        namespace: None,
+        arguments: r#"{"cmd":"cat deploy.toml"}"#.to_string(),
+    });
+
+    let scored = score_turn(&query, "id", &hit).expect("execution matches");
+
+    assert_eq!(scored.excerpt_source, "check the config");
+}
+
+#[test]
+fn unicode_terms_match_case_insensitively_as_whole_words() {
+    let cjk = PreparedQuery::new("部署使用钴蓝");
+    let saved = turn("请记住：部署使用钴蓝。", /*assistant*/ None);
+    let scored = score_turn(&cjk, "id", &saved).expect("CJK term matches");
+    assert_eq!(scored.excerpt_source, "请记住：部署使用钴蓝。");
+
+    let accented = PreparedQuery::new("CAFÉ");
+    assert!(
+        score_turn(
+            &accented,
+            "id",
+            &turn("Le café est prêt", /*assistant*/ None)
+        )
+        .is_some()
+    );
+    assert!(score_turn(&accented, "id", &turn("cafés", /*assistant*/ None)).is_none());
+
+    let long = format!("{}部署使用钴蓝{}", "字".repeat(200), "字".repeat(200));
+    let cut = excerpt(&long, &cjk, 320);
+    assert!(cut.contains("部署使用钴蓝"));
+    assert!(cut.len() <= 320);
+}
