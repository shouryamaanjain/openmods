diff --git a/codex-rs/core/tests/suite/session_history.rs b/codex-rs/core/tests/suite/session_history.rs
new file mode 100644
index 0000000000000000000000000000000000000000..8581cbeaec304ac2679f550727181fe84339581f
--- /dev/null
+++ b/codex-rs/core/tests/suite/session_history.rs
@@ -0,0 +1,223 @@
+use std::io::Write;
+use std::path::Path;
+
+use anyhow::Result;
+use codex_protocol::ThreadId;
+use core_test_support::responses::ResponsesRequest;
+use core_test_support::responses::ev_assistant_message;
+use core_test_support::responses::ev_completed;
+use core_test_support::responses::ev_function_call;
+use core_test_support::responses::ev_response_created;
+use core_test_support::responses::mount_sse_sequence;
+use core_test_support::responses::sse;
+use core_test_support::responses::start_mock_server;
+use core_test_support::skip_if_no_network;
+use core_test_support::test_codex::test_codex;
+use pretty_assertions::assert_eq;
+use serde_json::Value;
+use serde_json::json;
+
+const SEARCH_TOOL: &str = "session_history_search";
+const READ_TOOL: &str = "session_history_read";
+
+fn tool_names(request: &ResponsesRequest) -> Vec<String> {
+    request
+        .body_json()
+        .get("tools")
+        .and_then(Value::as_array)
+        .into_iter()
+        .flatten()
+        .filter_map(|tool| tool.get("name").and_then(Value::as_str).map(str::to_string))
+        .collect()
+}
+
+fn tool_output(request: &ResponsesRequest, call_id: &str) -> Value {
+    let text = request
+        .function_call_output_text(call_id)
+        .expect("tool output text");
+    serde_json::from_str(&text).expect("tool output is JSON")
+}
+
+/// An earlier saved session of the same project, in Codex's rollout format.
+fn write_saved_session(codex_home: &Path, cwd: &Path, id: ThreadId) -> Result<()> {
+    let dir = codex_home.join("sessions/2026/01/01");
+    std::fs::create_dir_all(&dir)?;
+    let mut file =
+        std::fs::File::create(dir.join(format!("rollout-2026-01-01T00-00-00-{id}.jsonl")))?;
+    let timestamp = "2026-01-01T00:00:00.000Z";
+    let lines = [
+        json!({ "timestamp": timestamp, "type": "session_meta", "payload": {
+            "session_id": id.to_string(), "id": id.to_string(), "timestamp": timestamp,
+            "cwd": cwd, "originator": "test", "cli_version": "test", "source": "cli",
+        }}),
+        json!({ "timestamp": timestamp, "type": "response_item", "payload": {
+            "type": "message", "role": "user",
+            "content": [{ "type": "input_text", "text": "Which cobalt shade did we pick?" }],
+        }}),
+        json!({ "timestamp": timestamp, "type": "event_msg", "payload": {
+            "type": "user_message", "message": "Which cobalt shade did we pick?", "kind": "plain",
+        }}),
+        json!({ "timestamp": timestamp, "type": "response_item", "payload": {
+            "type": "message", "role": "assistant", "phase": "final_answer",
+            "content": [{ "type": "output_text", "text": "Dark cobalt." }],
+        }}),
+    ];
+    for line in lines {
+        writeln!(file, "{line}")?;
+    }
+    file.set_modified(std::time::SystemTime::now() - std::time::Duration::from_secs(3_600))?;
+    Ok(())
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn model_searches_then_reads_saved_session_history() -> Result<()> {
+    skip_if_no_network!(Ok(()));
+
+    let server = start_mock_server().await;
+    let first = mount_sse_sequence(
+        &server,
+        vec![
+            sse(vec![
+                ev_response_created("resp-1"),
+                ev_assistant_message("msg-1", "Cobalt is selected."),
+                ev_completed("resp-1"),
+            ]),
+            sse(vec![
+                ev_response_created("resp-2"),
+                ev_function_call("search-1", SEARCH_TOOL, r#"{"query":"cobalt"}"#),
+                ev_completed("resp-2"),
+            ]),
+            sse(vec![
+                ev_response_created("resp-3"),
+                ev_assistant_message("msg-3", "found it"),
+                ev_completed("resp-3"),
+            ]),
+        ],
+    )
+    .await;
+    let test = test_codex().build(&server).await?;
+    let current = test.session_configured.thread_id;
+    let older = ThreadId::new();
+    write_saved_session(test.codex_home_path(), test.config.cwd.as_path(), older)?;
+
+    test.submit_turn("Use cobalt for the deploy").await?;
+    test.submit_turn("What did we pick?").await?;
+
+    let requests = first.requests();
+    assert_eq!(requests.len(), 3);
+    let names = tool_names(&requests[0]);
+    assert!(names.iter().any(|name| name == SEARCH_TOOL));
+    assert!(names.iter().any(|name| name == READ_TOOL));
+
+    let search = tool_output(&requests[2], "search-1");
+    let hits = search["hits"].as_array().expect("hits");
+    let summary: Vec<(String, String, String)> = hits
+        .iter()
+        .map(|hit| {
+            (
+                hit["session_id"].as_str().unwrap_or_default().to_string(),
+                hit["session_relation"]
+                    .as_str()
+                    .unwrap_or_default()
+                    .to_string(),
+                hit["excerpt"].as_str().unwrap_or_default().to_string(),
+            )
+        })
+        .collect();
+    assert_eq!(
+        summary,
+        vec![
+            (
+                current.to_string(),
+                "current".to_string(),
+                "Use cobalt for the deploy".to_string()
+            ),
+            (
+                older.to_string(),
+                "other".to_string(),
+                "Which cobalt shade did we pick?".to_string()
+            ),
+        ]
+    );
+    assert_eq!(search["content_authority"], "untrusted_historical_context");
+    assert_eq!(search["truncated"], false);
+
+    let reference = hits[1]["reference"].as_str().expect("reference");
+    let read_arguments = json!({ "reference": reference, "include_execution": true }).to_string();
+    let second = mount_sse_sequence(
+        &server,
+        vec![
+            sse(vec![
+                ev_response_created("resp-4"),
+                ev_function_call("read-1", READ_TOOL, &read_arguments),
+                ev_completed("resp-4"),
+            ]),
+            sse(vec![
+                ev_response_created("resp-5"),
+                ev_assistant_message("msg-5", "Dark cobalt it is."),
+                ev_completed("resp-5"),
+            ]),
+        ],
+    )
+    .await;
+
+    test.submit_turn("Read that hit").await?;
+
+    let requests = second.requests();
+    assert_eq!(requests.len(), 2);
+    assert_eq!(
+        tool_output(&requests[1], "read-1"),
+        json!({
+            "kind": "session_history_record",
+            "workspace_scope": "same_project",
+            "content_authority": "untrusted_historical_context",
+            "session_id": older.to_string(),
+            "session_relation": "other",
+            "turn_kind": "assistant",
+            "conversation": {
+                "user": "Which cobalt shade did we pick?",
+                "assistant": "Dark cobalt.",
+            },
+            "execution": {
+                "commentary": [],
+                "tool_calls": [],
+                "tool_results": [],
+                "files": [],
+                "truncated": false,
+            },
+        })
+    );
+
+    Ok(())
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn session_history_tools_are_not_offered_to_ephemeral_sessions() -> Result<()> {
+    skip_if_no_network!(Ok(()));
+
+    let server = start_mock_server().await;
+    let responses = mount_sse_sequence(
+        &server,
+        vec![sse(vec![
+            ev_response_created("resp-1"),
+            ev_assistant_message("msg-1", "hi"),
+            ev_completed("resp-1"),
+        ])],
+    )
+    .await;
+    let test = test_codex()
+        .with_config(|config| config.ephemeral = true)
+        .build(&server)
+        .await?;
+
+    test.submit_turn("hello").await?;
+
+    let names = tool_names(&responses.single_request());
+    assert!(
+        !names
+            .iter()
+            .any(|name| name == SEARCH_TOOL || name == READ_TOOL)
+    );
+
+    Ok(())
+}
