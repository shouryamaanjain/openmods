+import { describe, expect } from "bun:test"
+import { eq } from "drizzle-orm"
+import { Effect, Layer, Schema } from "effect"
+import { Bus } from "@opencode/core/bus"
+import { Database } from "@opencode/core/database/database"
+import { AppNodeBuilder } from "@opencode/core/effect/app-node-builder"
+import { Image } from "@opencode/core/image"
+import { LocationServiceMap } from "@opencode/core/location-service-map"
+import { Project } from "@opencode/core/project"
+import { ProjectTable } from "@opencode/core/project/sql"
+import { Session } from "@opencode/core/session"
+import { SessionEvent } from "@opencode/core/session/event"
+import { SessionExecution } from "@opencode/core/session/execution"
+import { SessionMessage } from "@opencode/core/session/message"
+import { SessionProjector } from "@opencode/core/session/projector"
+import { SessionMessageTable, SessionTable } from "@opencode/core/session/sql"
+import { SessionStore } from "@opencode/core/session/store"
+import { Tool } from "@opencode/core/tool"
+import { SessionHistoryTools } from "@opencode/core/tool/plugin/session-history"
+import { AbsolutePath } from "@opencode/schema/schema"
+import { makeLocationNode } from "@opencode/util/effect/app-node"
+import { LayerNode } from "@opencode/util/effect/layer-node"
+import { promptLocationNode } from "./fixture/prompt-location"
+import { testEffect } from "./lib/effect"
+import { imagePassthrough } from "./lib/image"
+import { globalProjectNode } from "./lib/project"
+import { executeTool, registerToolPlugin, toolDefinitions, toolIdentity } from "./lib/tool"
+
+const historyToolNode = makeLocationNode({
+  name: "test/session-history-tool-plugin",
+  layer: Layer.effectDiscard(registerToolPlugin(SessionHistoryTools.Plugin)),
+  deps: [Tool.node, Session.node],
+})
+
+const it = testEffect(
+  AppNodeBuilder.build(
+    LayerNode.group([
+      Database.node,
+      Bus.node,
+      SessionProjector.node,
+      SessionStore.node,
+      Session.node,
+      Tool.node,
+      historyToolNode,
+    ]),
+    [
+      Bus.node.replace(Bus.configured({ persist: true })),
+      Project.node.replace(globalProjectNode),
+      LocationServiceMap.node.replace(promptLocationNode),
+      SessionExecution.node.replace(SessionExecution.noopLayer),
+      Image.node.replace(imagePassthrough),
+    ],
+  ),
+)
+
+const projectA = Project.ID.make("prj_history_a")
+const projectB = Project.ID.make("prj_history_b")
+const model = { id: "test-model", providerID: "test" }
+
+type Encoded = Record<string, unknown> & { readonly type: SessionMessage.Type }
+
+const user = (text: string): Encoded => ({ type: "user", text, time: { created: 1 } })
+
+const assistant = (content: ReadonlyArray<Record<string, unknown>>, fields: Record<string, unknown> = {}): Encoded => ({
+  type: "assistant",
+  agent: "build",
+  model,
+  content,
+  time: { created: 1, completed: 2 },
+  ...fields,
+})
+
+const reply = (text: string) => assistant([{ type: "text", text }])
+
+const tool = (id: string, name: string, input: Record<string, unknown>, output: string) => ({
+  type: "tool",
+  id,
+  name,
+  state: { status: "completed", input, content: [{ type: "text", text: output }] },
+  time: { created: 1, completed: 2 },
+})
+
+const decodeMessage = Schema.decodeUnknownSync(SessionMessage.Info)
+
+/** Seeds one saved Session and its projected messages, oldest first. */
+const seed = (input: {
+  readonly id: string
+  readonly project?: Project.ID
+  readonly directory?: string
+  readonly updated: number
+  readonly parentID?: string
+  readonly messages: ReadonlyArray<Encoded>
+}) =>
+  Effect.gen(function* () {
+    const database = yield* Database.Service
+    const bus = yield* Bus.Service
+    const sessionID = Session.ID.make(input.id)
+    const project = input.project ?? projectA
+    const directory = AbsolutePath.make(input.directory ?? `/work/${project}`)
+    yield* database.db
+      .insert(ProjectTable)
+      .values({ id: project, worktree: directory, sandboxes: [] })
+      .onConflictDoNothing()
+      .run()
+    yield* bus.publish(SessionEvent.Created, {
+      sessionID,
+      projectID: project,
+      parentID: input.parentID === undefined ? undefined : Session.ID.make(input.parentID),
+      location: { directory },
+      slug: "history-test",
+      version: "test",
+    })
+    const rows = input.messages.map((message, index) => {
+      const id = SessionMessage.ID.make(`msg_${input.id}_${String(index).padStart(6, "0")}`)
+      decodeMessage({ ...message, id })
+      const { type, ...data } = message
+      return {
+        id,
+        session_id: sessionID,
+        type,
+        seq: index + 1,
+        time_created: index + 1,
+        time_updated: index + 1,
+        data: data as typeof SessionMessageTable.$inferInsert.data,
+      }
+    })
+    yield* Effect.forEach(
+      Array.from({ length: Math.ceil(rows.length / 500) }, (_, chunk) => rows.slice(chunk * 500, chunk * 500 + 500)),
+      (chunk) => database.db.insert(SessionMessageTable).values(chunk).run(),
+      { discard: true },
+    )
+    yield* database.db
+      .update(SessionTable)
+      .set({ time_updated: input.updated })
+      .where(eq(SessionTable.id, sessionID))
+      .run()
+    return sessionID
+  }).pipe(Effect.orDie)
+
+const call = (sessionID: string, name: string, input: Record<string, unknown>) =>
+  Effect.gen(function* () {
+    const registry = yield* Tool.Service
+    const result = yield* executeTool(registry, {
+      sessionID: Session.ID.make(sessionID),
+      ...toolIdentity,
+      call: { type: "tool-call", id: `call-${name}`, name, input },
+    })
+    if (result.status === "error") return { error: result.error?.message ?? "" }
+    const content = result.content?.[0]
+    return { value: JSON.parse(content?.type === "text" ? content.text : "null") }
+  })
+
+const search = (sessionID: string, input: Record<string, unknown>) =>
+  call(sessionID, SessionHistoryTools.searchName, input)
+const read = (sessionID: string, input: Record<string, unknown>) => call(sessionID, SessionHistoryTools.readName, input)
+
+// The current Session's newest turn is the one running the tool call.
+const running = [
+  user("look up what we said earlier"),
+  assistant([tool("call_now", "session_history_search", { query: "cobalt" }, "...")]),
+]
+
+describe("SessionHistoryTools", () => {
+  it.effect("advertises both tools with the shared contract", () =>
+    Effect.gen(function* () {
+      const definitions = yield* toolDefinitions(yield* Tool.Service)
+      const searchTool = definitions.find((item) => item.name === "session_history_search")
+      const readTool = definitions.find((item) => item.name === "session_history_read")
+      expect(searchTool?.description).toBe(SessionHistoryTools.searchDescription)
+      expect(readTool?.description).toBe(SessionHistoryTools.readDescription)
+      expect(searchTool?.inputSchema).toMatchObject({
+        type: "object",
+        required: ["query"],
+        properties: {
+          query: { type: "string", minLength: 1, maxLength: 512 },
+          limit: { type: "integer", minimum: 1, maximum: 20 },
+        },
+      })
+      expect(readTool?.inputSchema).toMatchObject({
+        type: "object",
+        required: ["reference"],
+        properties: {
+          reference: { type: "string", minLength: 1, maxLength: 512 },
+          include_execution: { type: "boolean" },
+        },
+      })
+    }),
+  )
+
+  it.effect("searches the current project only, reports current or other, and reads a hit back", () =>
+    Effect.gen(function* () {
+      yield* seed({
+        id: "ses_current",
+        updated: 300,
+        messages: [user("Use cobalt for the deploy"), reply("Cobalt is selected."), ...running],
+      })
+      yield* seed({
+        id: "ses_older",
+        updated: 200,
+        messages: [user("Did we choose cobalt?"), reply("Yes, keep cobalt.")],
+      })
+      yield* seed({
+        id: "ses_outside",
+        project: projectB,
+        updated: 400,
+        messages: [user("Cobalt belongs elsewhere"), reply("Do not expose it."), ...running],
+      })
+      yield* seed({
+        id: "ses_child",
+        parentID: "ses_older",
+        updated: 500,
+        messages: [user("cobalt from a subagent prompt"), reply("cobalt")],
+      })
+
+      const result = yield* search("ses_current", { query: "cobalt" })
+      expect(result.value).toEqual({
+        kind: "session_history_search",
+        workspace_scope: "same_project",
+        content_authority: "untrusted_historical_context",
+        hits: [
+          {
+            reference: expect.stringMatching(/^ochr1:ses_current:0:[0-9a-f]{64}$/),
+            session_id: "ses_current",
+            session_relation: "current",
+            excerpt: "Use cobalt for the deploy",
+          },
+          {
+            reference: expect.stringMatching(/^ochr1:ses_older:0:[0-9a-f]{64}$/),
+            session_id: "ses_older",
+            session_relation: "other",
+            excerpt: "Did we choose cobalt?",
+          },
+        ],
+        truncated: false,
+      })
+
+      const record = yield* read("ses_current", { reference: result.value.hits[1].reference })
+      expect(record.value).toEqual({
+        kind: "session_history_record",
+        workspace_scope: "same_project",
+        content_authority: "untrusted_historical_context",
+        session_id: "ses_older",
+        session_relation: "other",
+        turn_kind: "assistant",
+        conversation: { user: "Did we choose cobalt?", assistant: "Yes, keep cobalt." },
+      })
+      expect((yield* read("ses_current", { reference: result.value.hits[0].reference })).value).toMatchObject({
+        session_id: "ses_current",
+        session_relation: "current",
+      })
+      // The same turn seen from the other Session flips the relation.
+      const fromOlder = yield* search("ses_older", { query: "cobalt deploy" })
+      expect(fromOlder.value.hits[0]).toMatchObject({ session_id: "ses_current", session_relation: "other" })
+
+      // A reference minted in another project never reads back here.
+      const outside = yield* search("ses_outside", { query: "cobalt" })
+      expect(outside.value.hits).toEqual([expect.objectContaining({ session_id: "ses_outside" })])
+      expect(yield* read("ses_current", { reference: outside.value.hits[0].reference })).toEqual({
+        error: "session_history_read reference is unavailable",
+      })
+    }),
+  )
+
+  it.effect("scopes Sessions of the global project by directory", () =>
+    Effect.gen(function* () {
+      yield* seed({
+        id: "ses_global_here",
+        project: Project.ID.global,
+        directory: "/scratch/here",
+        updated: 100,
+        messages: [user("ultramarine plan"), reply("ok"), ...running],
+      })
+      yield* seed({
+        id: "ses_global_there",
+        project: Project.ID.global,
+        directory: "/scratch/there",
+        updated: 200,
+        messages: [user("ultramarine elsewhere"), reply("ok")],
+      })
+      expect((yield* search("ses_global_here", { query: "ultramarine" })).value.hits).toEqual([
+        expect.objectContaining({ session_id: "ses_global_here" }),
+      ])
+    }),
+  )
+
+  it.effect("ranks more matched terms first, user and assistant text above execution, ties newest first", () =>
+    Effect.gen(function* () {
+      yield* seed({ id: "ses_ranker", updated: 900, messages: running })
+      yield* seed({ id: "ses_one_term", updated: 800, messages: [user("alpha only"), reply("done")] })
+      yield* seed({
+        id: "ses_weak",
+        updated: 700,
+        messages: [
+          user("run the tool"),
+          assistant([tool("call_weak", "grep", { pattern: "alpha beta" }, "none")]),
+          reply("done"),
+        ],
+      })
+      yield* seed({ id: "ses_concise", updated: 600, messages: [user("alpha"), reply("beta")] })
+      yield* seed({
+        id: "ses_repetitive",
+        updated: 500,
+        messages: [user("alpha beta"), reply("alpha beta alpha beta")],
+      })
+
+      const result = yield* search("ses_ranker", { query: "alpha beta" })
+      expect(result.value.hits.map((hit: { session_id: string }) => hit.session_id)).toEqual([
+        "ses_concise",
+        "ses_repetitive",
+        "ses_weak",
+        "ses_one_term",
+      ])
+      // Naming a Session's ID ranks its turns first.
+      const named = yield* search("ses_ranker", { query: "ses_one_term beta" })
+      expect(named.value.hits[0].session_id).toBe("ses_one_term")
+    }),
+  )
+
+  it.effect("bounds hits and excerpts and reports truncation", () =>
+    Effect.gen(function* () {
+      const long = `${"lorem ipsum ".repeat(60)}the vermilion decision ${"dolor sit é ".repeat(60)}`
+      yield* seed({
+        id: "ses_bounds",
+        updated: 100,
+        messages: [user(long), reply("noted"), user("vermilion again"), reply("noted"), ...running],
+      })
+
+      const limited = yield* search("ses_bounds", { query: "vermilion", limit: 1 })
+      expect(limited.value.hits).toHaveLength(1)
+      expect(limited.value.truncated).toBe(true)
+
+      const all = yield* search("ses_bounds", { query: "vermilion decision" })
+      expect(all.value.truncated).toBe(false)
+      const excerpt: string = all.value.hits[0].excerpt
+      expect(excerpt.startsWith("...")).toBe(true)
+      expect(excerpt.endsWith("...")).toBe(true)
+      expect(excerpt).toContain("vermilion decision")
+      expect(excerpt).not.toContain("�")
+      expect(Buffer.byteLength(excerpt.slice(3, -3))).toBeLessThanOrEqual(SessionHistoryTools.MAX_EXCERPT_BYTES)
+
+      expect(yield* search("ses_bounds", { query: "   " })).toEqual({
+        error: 'session_history_search field "query" must not be empty',
+      })
+      expect((yield* search("ses_bounds", { query: "vermilion", limit: 21 })).error).toBeString()
+      expect((yield* search("ses_bounds", { query: "vermilion", limit: 0 })).error).toBeString()
+      expect((yield* search("ses_bounds", { query: "x".repeat(513) })).error).toBeString()
+    }),
+  )
+
+  it.effect("stops at the Session, turn and searchable-byte bounds", () =>
+    Effect.gen(function* () {
+      yield* seed({ id: "ses_scan", updated: 100_000, messages: running })
+      yield* Effect.forEach(
+        Array.from({ length: SessionHistoryTools.MAX_SESSIONS }, (_, index) => index),
+        (index) =>
+          seed({
+            id: `ses_many_${String(index).padStart(3, "0")}`,
+            updated: index + 10,
+            messages: [user(index === 0 ? "oldest teal note" : "ordinary"), reply("ok")],
+          }),
+        { discard: true },
+      )
+      // The oldest Session is the 101st in scope, beyond the Session bound.
+      expect((yield* search("ses_scan", { query: "teal" })).value).toMatchObject({ hits: [], truncated: true })
+      expect((yield* search("ses_scan", { query: "ordinary", limit: 20 })).value.hits).toHaveLength(20)
+    }),
+  )
+
+  it.effect("skips turns past the turn and byte bounds", () =>
+    Effect.gen(function* () {
+      yield* seed({
+        id: "ses_turns",
+        updated: 100,
+        messages: [
+          user("ancient saffron turn"),
+          ...Array.from({ length: SessionHistoryTools.MAX_TURNS }, () => user("filler")),
+          ...running,
+        ],
+      })
+      expect((yield* search("ses_turns", { query: "saffron" })).value).toEqual(
+        expect.objectContaining({ hits: [], truncated: true }),
+      )
+      expect((yield* search("ses_turns", { query: "filler", limit: 1 })).value.hits).toHaveLength(1)
+    }),
+  )
+
+  it.effect("skips a turn larger than the searchable-byte budget", () =>
+    Effect.gen(function* () {
+      yield* seed({
+        id: "ses_bytes",
+        updated: 100,
+        messages: [
+          user("small magenta turn"),
+          reply("ok"),
+          user(`magenta ${"x".repeat(SessionHistoryTools.MAX_SEARCHABLE_BYTES)}`),
+          reply("ok"),
+          ...running,
+        ],
+      })
+      const result = yield* search("ses_bytes", { query: "magenta" })
+      expect(result.value).toMatchObject({ truncated: true, hits: [{ excerpt: "small magenta turn" }] })
+    }),
+  )
+
+  it.effect("rejects malformed and tampered references", () =>
+    Effect.gen(function* () {
+      const sessionID = yield* seed({
+        id: "ses_tamper",
+        updated: 100,
+        messages: [user("the indigo choice"), reply("indigo it is"), user("second"), reply("ok"), ...running],
+      })
+      const hit: string = (yield* search("ses_tamper", { query: "indigo" })).value.hits[0].reference
+      expect((yield* read("ses_tamper", { reference: hit })).value.conversation.user).toBe("the indigo choice")
+
+      const unavailable = { error: "session_history_read reference is unavailable" }
+      const malformed = { error: "session_history_read reference is malformed" }
+      const digit = hit.at(-1) === "0" ? "1" : "0"
+      expect(yield* read("ses_tamper", { reference: hit.slice(0, -1) + digit })).toEqual(unavailable)
+      expect(yield* read("ses_tamper", { reference: hit.replace(":0:", ":1:") })).toEqual(unavailable)
+      expect(yield* read("ses_tamper", { reference: hit.replace("ses_tamper", "ses_missing") })).toEqual(unavailable)
+      expect(yield* read("ses_tamper", { reference: hit.replace("ochr1", "fxhr1") })).toEqual(malformed)
+      expect(yield* read("ses_tamper", { reference: hit.slice(0, -2) })).toEqual(malformed)
+      expect(yield* read("ses_tamper", { reference: "not-a-reference" })).toEqual(malformed)
+      expect(yield* read("ses_tamper", { reference: "   " })).toEqual({
+        error: 'session_history_read field "reference" must not be empty',
+      })
+
+      // Changed content invalidates the reference.
+      const database = yield* Database.Service
+      yield* database.db
+        .update(SessionMessageTable)
+        .set({ data: { text: "the indigo choice, edited", time: { created: 1 } } })
+        .where(eq(SessionMessageTable.id, SessionMessage.ID.make(`msg_${sessionID}_000000`)))
+        .run()
+        .pipe(Effect.orDie)
+      expect(yield* read("ses_tamper", { reference: hit })).toEqual(unavailable)
+    }),
+  )
+
+  it.effect("returns execution evidence only when asked", () =>
+    Effect.gen(function* () {
+      yield* seed({
+        id: "ses_exec",
+        updated: 100,
+        messages: [
+          user("fix the crimson bug"),
+          assistant(
+            [
+              { type: "text", text: "Reading the file first." },
+              tool("call_read", "read", { filePath: "src/crimson.ts" }, "export const crimson = 1"),
+            ],
+            { snapshot: { files: ["src/crimson.ts"] } },
+          ),
+          reply("Fixed it."),
+          { type: "idle", outcome: "succeeded", time: { created: 3 } },
+          ...running,
+        ],
+      })
+      // Execution evidence is searchable, weakly.
+      const hit = (yield* search("ses_exec", { query: "crimson.ts" })).value.hits[0]
+      expect(hit.excerpt).toBe("fix the crimson bug")
+
+      expect((yield* read("ses_exec", { reference: hit.reference })).value.execution).toBeUndefined()
+      const record = yield* read("ses_exec", { reference: hit.reference, include_execution: true })
+      expect(record.value).toMatchObject({
+        turn_kind: "assistant",
+        conversation: { user: "fix the crimson bug", assistant: "Fixed it." },
+        execution: {
+          tool_steps: [
+            {
+              assistant: "Reading the file first.",
+              tool_calls: [{ id: "call_read", name: "read", arguments: '{"filePath":"src/crimson.ts"}' }],
+              tool_results: [
+                { id: "call_read", name: "read", status: "completed", preview: "export const crimson = 1" },
+              ],
+            },
+          ],
+          files: [{ path: "src/crimson.ts" }],
+        },
+      })
+    }),
+  )
+
+  it.effect("skips compaction summaries and keeps the turns they summarized", () =>
+    Effect.gen(function* () {
+      yield* seed({
+        id: "ses_compacted",
+        updated: 100,
+        messages: [
+          user("pick the olive palette"),
+          reply("Olive chosen."),
+          {
+            type: "compaction",
+            status: "completed",
+            reason: "auto",
+            summary: "The zebra summary of earlier work",
+            recent: "zebra recent",
+            time: { created: 3 },
+          },
+          user("next task"),
+          {
+            type: "assistant",
+            agent: "build",
+            model,
+            content: [],
+            error: { type: "unknown", message: "stopped" },
+            time: { created: 4 },
+          },
+          { type: "idle", outcome: "interrupted", time: { created: 5 } },
+          ...running,
+        ],
+      })
+      expect((yield* search("ses_compacted", { query: "zebra" })).value.hits).toEqual([])
+      const olive = (yield* search("ses_compacted", { query: "olive" })).value.hits
+      expect(olive).toEqual([expect.objectContaining({ reference: expect.stringMatching(/^ochr1:ses_compacted:0:/) })])
+      const next = (yield* search("ses_compacted", { query: "next task" })).value.hits[0]
+      expect(next.reference).toMatch(/^ochr1:ses_compacted:1:/)
+      expect((yield* read("ses_compacted", { reference: next.reference })).value).toMatchObject({
+        turn_kind: "interrupted",
+        conversation: { user: "next task", assistant: null },
+      })
+    }),
+  )
+})
