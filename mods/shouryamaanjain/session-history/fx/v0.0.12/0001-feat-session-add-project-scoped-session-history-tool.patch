+    ) bool {
+        var matched = false;
+        for (0..query.token_count) |index| {
+            if (!containsIgnoreCase(field, query.tokenAt(index))) continue;
+            matched = true;
+            if (!self.strong_tokens.isSet(index)) self.weak_tokens.set(index);
+        }
+        return matched;
+    }
+
+    pub fn finish(self: ScoreAccumulator, query: *const PreparedQuery) ?Score {
+        const result = Score{
+            .exact_identity = self.exact_identity,
+            .strong_hits = self.strong_tokens.count(),
+            .weak_hits = self.weak_tokens.count(),
+        };
+        if (!result.exact_identity and
+            result.strong_hits == 0 and
+            result.weak_hits == 0 and
+            query.raw.len != 0)
+        {
+            return null;
+        }
+        return result;
+    }
+};
