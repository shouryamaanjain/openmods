{
  "$schema": "../schema/harness.schema.json",
  "id": "opencode",
  "name": "OpenCode",
  "repo": "https://github.com/anomalyco/opencode",
  "homepage": "https://opencode.ai",
  "license": "MIT",
  "language": "TypeScript (Bun, SolidJS, opentui)",
  "binary": "opencode",
  "installer": {
    "command": "curl -fsSL https://opencode.ai/install | bash",
    "paths": [
      "~/.opencode/bin"
    ]
  },
  "requirements": [
    {
      "command": "bun",
      "hint": "Install Bun from https://bun.sh (the exact version a release pins is provisioned automatically)"
    },
    {
      "command": "git",
      "hint": "Install git"
    }
  ],
  "install": "bun install",
  "typecheck": "bun turbo typecheck --filter=\"...[${OPEN_MODS_REF}]\" --concurrency=2",
  "build": "OPENCODE_VERSION=\"${OPEN_MODS_VERSION}+${OPEN_MODS_MODS}\" OPENCODE_CHANNEL=open-mods bun run packages/opencode/script/build.ts --single --skip-install",
  "artifact": "packages/opencode/dist/opencode-{os}-{arch}/bin/opencode",
  "recipe": [
    {
      "file": "packages/opencode/script/build.ts"
    },
    {
      "file": "packages/script/src/index.ts"
    },
    {
      "file": "package.json",
      "lines": "\"(packageManager|typecheck)\""
    },
    {
      "file": "turbo.json"
    }
  ],
  "releaseTagPattern": "v*"
}
