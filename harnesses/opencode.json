{
  "$schema": "../schema/harness.schema.json",
  "id": "opencode",
  "name": "OpenCode",
  "repo": "https://github.com/anomalyco/opencode",
  "homepage": "https://opencode.ai",
  "license": "MIT",
  "language": "TypeScript (Bun, SolidJS, opentui)",
  "binary": "opencode",
  "installer": {
    "command": "curl -fsSL https://opencode.ai/v2/install | bash",
    "paths": [
      "~/.opencode/bin"
    ]
  },
  "requirements": [
    {
      "command": "bun",
      "hint": "Bun: https://bun.sh (the exact version a release pins is provisioned automatically)"
    },
    {
      "command": "git",
      "hint": "git",
      "name": "git",
      "packages": {
        "apt": "git",
        "dnf": "git",
        "brew": "git"
      }
    }
  ],
  "install": "bun install --ignore-scripts",
  "typecheck": "bun turbo typecheck --filter=\"...[${OPENMODS_REF}]\" --concurrency=2",
  "build": "OPENCODE_VERSION=\"${OPENMODS_VERSION}+${OPENMODS_MODS}\" OPENCODE_CHANNEL=openmods bun run packages/cli/script/build.ts --single --skip-install",
  "artifact": "packages/cli/dist/cli-{os}-{arch}/bin/opencode",
  "dev": "exec bun --preload={root}/packages/cli/node_modules/@opentui/solid/scripts/preload.js --define 'OPENCODE_VERSION=\"{version}\"' --define 'OPENCODE_CHANNEL=\"openmods\"' {root}/packages/cli/src/index.ts",
  "env": {
    "OPENCODE_DISABLE_AUTOUPDATE": "1"
  },
  "recipe": [
    {
      "file": "packages/cli/script/build.ts"
    },
    {
      "file": "packages/cli/script/app-assets.ts"
    },
    {
      "file": "packages/script/src/index.ts"
    },
    {
      "file": "package.json",
      "lines": "\"(packageManager|typecheck)\""
    },
    {
      "file": "turbo.json"
    }
  ],
  "releaseTagPattern": "v*",
  "latestRelease": {
    "url": "https://opencode.ai/update/api/latest/cli/npm",
    "tag": "v{version}"
  }
}
