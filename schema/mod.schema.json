{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/shouryamaanjain/openmods/main/schema/mod.schema.json",
  "title": "OpenMods mod",
  "description": "mods/<owner>/<name>/mod.json: what is shared by every harness the mod supports. Each supported harness has its own folder with a support.json.",
  "type": "object",
  "required": [
    "owner",
    "name",
    "description",
    "license"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "owner": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
      "description": "The author's GitHub handle, lowercase."
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "description": {
      "type": "string",
      "maxLength": 200
    },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "github": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      }
    },
    "maintainers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "GitHub handles the bot mentions when a new release breaks the mod."
    },
    "license": {
      "type": "string",
      "description": "SPDX identifier, e.g. MIT."
    },
    "homepage": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      },
      "uniqueItems": true
    },
    "internal": {
      "type": "boolean",
      "description": "Only for openmods/base, the patch OpenMods applies to every modded build: it is kept out of listings and cannot be installed or removed by users."
    }
  }
}
